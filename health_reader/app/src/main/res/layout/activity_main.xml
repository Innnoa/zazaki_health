<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面：标题 → 统计卡 → 待传横幅 → 日期列表（滚动）→ 底部操作区 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/sv_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_h"
            android:paddingEnd="@dimen/screen_padding_h"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm">

            <!-- 1. 头部 -->
            <TextView
                android:id="@+id/tv_header_title"
                style="@style/Text.Header.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/tv_subtitle"
                style="@style/Text.Header.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/subtitle_default" />

            <!-- 2. 状态总览卡：今日 / 连续 / 总传输 -->
            <LinearLayout
                android:id="@+id/card_stats"
                style="@style/Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/card_padding_v"
                android:paddingBottom="@dimen/card_padding_v">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_today"
                        style="@style/Text.Stat.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/common_dash" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/stat_label_today"
                        style="@style/Text.Stat.Label" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/divider_thickness"
                    android:layout_height="@dimen/height_stat_divider"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/divider_v" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_consec"
                        style="@style/Text.Stat.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/common_dash" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/stat_label_consec"
                        style="@style/Text.Stat.Label" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/divider_thickness"
                    android:layout_height="@dimen/height_stat_divider"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/divider_v" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_total"
                        style="@style/Text.Stat.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/common_dash" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/stat_label_total"
                        style="@style/Text.Stat.Label" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. 待传横幅（默认隐藏，N > 0 时显示） -->
            <LinearLayout
                android:id="@+id/ll_pending_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_banner_warning"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_xs"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_sm"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:text="⚠️"
                    android:textSize="@dimen/text_size_banner" />

                <TextView
                    android:id="@+id/tv_pending_banner"
                    style="@style/Text.Banner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_backfill"
                    style="@style/Button.BannerAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="@string/action_backfill" />
            </LinearLayout>

            <!-- 4a. 日期列表标题 -->
            <TextView
                android:id="@+id/tv_day_section_title"
                style="@style/Text.Section.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xl"
                android:text="@string/section_days_default" />

            <!-- 4b. 日期列表容器（代码按天 inflate item_day_row 追加，行间自动细分隔线） -->
            <LinearLayout
                android:id="@+id/ll_day_list"
                style="@style/Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:divider="@drawable/divider_h"
                android:dividerPadding="@dimen/row_padding_h"
                android:orientation="vertical"
                android:paddingTop="@dimen/list_padding_v"
                android:paddingBottom="@dimen/list_padding_v"
                android:showDividers="middle" />

        </LinearLayout>
    </ScrollView>

    <!-- 5. 底部操作区：反馈行 + 主按钮 + 提醒设置 -->
    <LinearLayout
        android:id="@+id/ll_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_page"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_h"
        android:paddingEnd="@dimen/screen_padding_h"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_lg">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_thickness"
            android:background="@drawable/divider_h" />

        <!-- 状态/进度反馈行（默认隐藏；传输中/完成/失败时显示） -->
        <LinearLayout
            android:id="@+id/ll_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_feedback"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_feedback_check"
                android:layout_width="@dimen/icon_feedback"
                android:layout_height="@dimen/icon_feedback"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_feedback"
                style="@style/Text.Feedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_primary"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_btn_primary"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/action_transfer_default" />

        <Button
            android:id="@+id/btn_settings"
            style="@style/Button.GhostLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/action_settings" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标前景层（108dp 画布，主体落在中心 66x66 安全区 / 66dp 安全圆内）
     视觉：顺时针同步箭头（开口圆环）+ 心率折线，扁平极简，无文字无渐变。
     颜色取自 res/values/colors.xml 的 primary。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 同步箭头：顺时针开口圆环（缺口 250°~308°，缺口顶端即箭头方向） -->
    <path
        android:pathData="M71.55,31.54A28.5,28.5 0 1 1 44.25,27.22"
        android:strokeColor="@color/primary"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- 同步箭头：箭头实心三角 -->
    <path
        android:pathData="M51.3,24.65L45.45,30.51L43.06,23.93Z"
        android:fillColor="@color/primary" />

    <!-- 心率折线：平直基线 + 单一锐利 QRS 尖峰 -->
    <path
        android:pathData="M34,58L45,58L49,65L54,44L59,65L63,58L74,58"
        android:strokeColor="@color/primary"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="miter"
        android:strokeMiterLimit="8" />
</vector>
